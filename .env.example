# =============================================================================
#  Chrono-DNS configuration
#  Copy to `.env` — every value below is the built-in default, so an empty
#  file works fine. Real environment variables always win over this file.
# =============================================================================

# --- Gateway -----------------------------------------------------------------
# 5353 avoids needing root. To run on real port 53 either use sudo or grant the
# capability once:  sudo setcap 'cap_net_bind_service=+ep' $(readlink -f $(which python3))
CHRONODNS_LISTEN_HOST=127.0.0.1
CHRONODNS_LISTEN_PORT=5353
CHRONODNS_ENABLE_TCP=true
CHRONODNS_UPSTREAM=1.1.1.1,9.9.9.9,8.8.8.8
CHRONODNS_UPSTREAM_PORT=53
CHRONODNS_UPSTREAM_TIMEOUT=2.5
CHRONODNS_CACHE_MAX=20000
CHRONODNS_CACHE_TTL_FLOOR=30
CHRONODNS_SINKHOLE_IP=0.0.0.0
CHRONODNS_MAX_CONCURRENT=512

# --- Database ----------------------------------------------------------------
# sqlite  -> zero install, file on disk (default)
# postgres-> production backend; needs `pip install asyncpg` and a live server
CHRONODNS_DB_BACKEND=sqlite
CHRONODNS_SQLITE_PATH=data/chronodns.db

CHRONODNS_PG_HOST=127.0.0.1
CHRONODNS_PG_PORT=5432
CHRONODNS_PG_USER=chronodns
CHRONODNS_PG_PASSWORD=chronodns
CHRONODNS_PG_DATABASE=chronodns
CHRONODNS_PG_POOL_MIN=2
CHRONODNS_PG_POOL_MAX=10

# Write-behind buffer: the gateway never blocks on the database.
CHRONODNS_DB_BATCH_SIZE=200
CHRONODNS_DB_FLUSH_INTERVAL=1.0

# --- Detection ---------------------------------------------------------------
# Ensemble fusion weights (should sum to 1.0)
CHRONODNS_W_SUPERVISED=0.65
CHRONODNS_W_ANOMALY=0.20
CHRONODNS_W_HEURISTIC=0.15

# Verdict bands on the fused 0..1 score
CHRONODNS_T_SUSPICIOUS=0.45
CHRONODNS_T_MALICIOUS=0.70

# Require N malicious verdicts within the window before actually blocking.
CHRONODNS_DEBOUNCE_HITS=2
CHRONODNS_DEBOUNCE_WINDOW=60

# Temporal analysis
CHRONODNS_WINDOW_SIZE=64
CHRONODNS_BEACON_MIN_SAMPLES=6
CHRONODNS_BEACON_CV=0.12
CHRONODNS_QPS_ALARM=40
CHRONODNS_NXDOMAIN_BURST=25

# ENFORCE=false is monitor-only: everything is scored and logged, nothing is
# blocked. Start every real deployment here.
CHRONODNS_ENFORCE=true
# On an internal error, resolve normally rather than breaking DNS.
CHRONODNS_FAIL_OPEN=true

# --- Machine learning --------------------------------------------------------
CHRONODNS_MODEL_DIR=models
CHRONODNS_RF_ESTIMATORS=200
CHRONODNS_RF_MAX_DEPTH=18
CHRONODNS_IF_ESTIMATORS=96
CHRONODNS_IF_CONTAM=0.06
CHRONODNS_TEST_SIZE=0.25
CHRONODNS_SEED=1337
CHRONODNS_N_JOBS=-1

# --- Web dashboard -----------------------------------------------------------
CHRONODNS_API_HOST=127.0.0.1
CHRONODNS_API_PORT=8088
CHRONODNS_API_REFRESH_MS=2000

# --- Logging -----------------------------------------------------------------
CHRONODNS_LOG_LEVEL=INFO
CHRONODNS_LOG_FILE=data/logs/chronodns.log
